# Speak English with Nick - Environment Configuration

# Destination Coach Email
COACH_EMAIL=speakenglishwithnick@gmail.com

# SMTP Email Configuration (e.g. Gmail SMTP)
# To generate a Gmail App Password:
# 1. Go to your Google Account -> Security -> 2-Step Verification -> App Passwords
# 2. Generate a new password for "Mail / Next.js App"
# 3. Paste your email and 16-character app password below:
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=speakenglishwithnick@gmail.com
SMTP_PASS=your-16-character-gmail-app-password
SMTP_FROM=speakenglishwithnick@gmail.com
